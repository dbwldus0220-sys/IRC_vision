+struct PlaybackTick {
+    double monotonic_ms{0}, interval_ms{0}, timeline_ms{0}, progress{0};
+    double write_ms{0}, write_started_ms{0}, goal_interval_ms{0}, queue_delay_ms{0};
+    int repeat{0}, frame{-1};
+    std::size_t motor_count{0};
+    bool final_goal{false}, sent{false}, success{false}, queued{false};
+    bool queue_activated{false}, head_override{false}, shoulder_override{false};
+    std::array<double, 23> goals{};
+};
+
+struct PlaybackDiagnostics {
+    std::string motion;
+    std::vector<std::string> frames;
+    std::vector<PlaybackTick> trace;
+    std::uint64_t ticks{0}, interval_count{0}, over_7_5{0}, over_10{0}, over_20{0};
+    std::uint64_t final_corrections{0}, goal_failures{0}, dropped_trace{0};
+    double expected_tick_ms{5}, interval_sum_ms{0}, max_interval_ms{0};
+    double started_ms{0}, finished_ms{0}, queue_delay_ms{0};
+    bool finished{false}, include_goals{false};
+};
+
+// File I/O runs on one worker. The control path only hands over a completed,
+// bounded trace with try_lock; an overloaded logger drops a batch, not a tick.
+class PlaybackTraceWriter {
+public:
+    explicit PlaybackTraceWriter(const std::string& path) : output_(path, std::ios::app) {
+        if (!output_) throw std::runtime_error("cannot open playback trace: " + path);
+        worker_ = std::thread([this] { run(); });
+    }
+    ~PlaybackTraceWriter() {
+        { std::lock_guard<std::mutex> lock(mutex_); stopping_ = true; }
+        wake_.notify_one();
+        worker_.join();
+    }
+    bool enqueue(std::shared_ptr<const PlaybackDiagnostics> batch) {
+        std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+        if (!lock || batches_.size() >= 4) return false;
+        batches_.push_back(std::move(batch));
+        wake_.notify_one();
+        return true;
+    }
+private:
+    void run() {
+        for (;;) {
+            std::shared_ptr<const PlaybackDiagnostics> batch;
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                wake_.wait(lock, [this] { return stopping_ || !batches_.empty(); });
+                if (batches_.empty()) return;
+                batch = std::move(batches_.front()); batches_.pop_front();
+            }
+            output_ << "summary," << std::quoted(batch->motion) << ','
+                    << batch->ticks << ',' << batch->expected_tick_ms << ','
+                    << (batch->interval_count ? batch->interval_sum_ms / batch->interval_count : 0)
+                    << ',' << batch->max_interval_ms << ',' << batch->over_7_5
+                    << ',' << batch->over_10 << ',' << batch->over_20 << ','
+                    << batch->final_corrections << ',' << batch->goal_failures << ','
+                    << batch->queue_delay_ms << ',' << batch->finished_ms - batch->started_ms
+                    << ',' << batch->dropped_trace << '\n';
+            for (const auto& t : batch->trace) {
+                output_ << "tick," << std::setprecision(15) << std::quoted(batch->motion)
+                        << ',' << t.monotonic_ms << ',' << batch->expected_tick_ms
+                        << ',' << t.interval_ms << ',' << t.repeat << ',' << t.frame << ','
+                        << std::quoted(t.frame >= 0 ? batch->frames.at(t.frame) : "")
+                        << ',' << t.timeline_ms << ',' << t.progress << ',' << t.final_goal
+                        << ',' << t.queued << ',' << t.queue_activated << ',' << t.queue_delay_ms
+                        << ',' << t.sent << ',' << t.success << ',' << t.write_ms
+                        << ',' << t.write_started_ms << ',' << t.goal_interval_ms
+                        << ',' << t.motor_count << ',' << t.head_override << ',' << t.shoulder_override;
+                if (batch->include_goals) for (double goal : t.goals) output_ << ',' << goal;
+                output_ << '\n';
+            }
+            output_.flush();
+        }
+    }
+    std::ofstream output_;
+    std::mutex mutex_;
+    std::condition_variable wake_;
+    std::deque<std::shared_ptr<const PlaybackDiagnostics>> batches_;
+    bool stopping_{false};
+    std::thread worker_;
+};
