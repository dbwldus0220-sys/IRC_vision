+      {"name":"repeat","max_seq_ms":100,"repeat_count":2,"frames":[{"name":"normal","start_ms":0,"time_ms":100,"angles":{"1":90}}]},
+      {"name":"cycle","max_seq_ms":200,"playback_speed":2,"frames":[{"name":"first","start_ms":0,"time_ms":100,"angles":{"1":30},"playback_cycle_end":true},{"name":"second","start_ms":100,"time_ms":100,"angles":{"1":60}}]}
