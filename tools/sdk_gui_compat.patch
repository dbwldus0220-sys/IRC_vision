+    {
+        auto now=RobotMotionPlayer::Clock::time_point{}+1s;
+        Hardware hw;RobotMotionPlayer p(path.string(),hw,[&]{return now;});
+        assert(p.initialize());assert(p.start("gaps")==StartResult::Accepted);
+        now+=1000ms;assert(p.update()==MotionStatus::Running);assert(hw.goal.at(1)==30);
+        now+=200ms;hw.present[1]=30;p.update();assert(hw.goal.at(1)==30);
+        now+=40ms;p.update();assert(hw.goal.at(1)==30);
+        now+=90ms;p.update();assert(std::abs(hw.goal.at(1)-45)<1e-9);
+        now+=50ms;assert(p.update()==MotionStatus::Running);assert(hw.goal.at(1)==60);
+        hw.present[1]=60;now+=20ms;assert(p.update()==MotionStatus::Settling);
+        now+=79ms;assert(p.update()==MotionStatus::Settling);
+        now+=21ms;assert(p.update()==MotionStatus::Succeeded);
+    }
+    // Queues need frame arrival, but retain the old no-settling transition.
+    {
+        auto now=RobotMotionPlayer::Clock::time_point{}+1s;
+        Hardware hw;RobotMotionPlayer p(path.string(),hw,[&]{return now;});
+        assert(p.initialize());assert(p.start("single")==StartResult::Accepted);
+        assert(p.queueNext("single")==QueueResult::Queued);
+        now+=100ms;assert(p.update()==MotionStatus::Running);assert(p.completionSequence()==0);
+        hw.present[1]=86;now+=19ms;p.update();assert(p.completionSequence()==0);
+        now+=1ms;p.update();assert(p.completionSequence()==1 && p.running());
+        assert(p.cancel()==CancelResult::Cancelled);assert(!p.hasQueuedMotion());
+    }
+    // Waiting must block repeats too, and reset frame checks for the next repeat.
+    {
+        auto now=RobotMotionPlayer::Clock::time_point{}+1s;
+        Hardware hw;RobotMotionPlayer p(path.string(),hw,[&]{return now;});
+        assert(p.initialize());assert(p.start("repeat")==StartResult::Accepted);
+        now+=100ms;p.update();now+=500ms;p.update();assert(p.completionSequence()==0);
+        hw.present[1]=90;now+=20ms;p.update();assert(p.status()==MotionStatus::Running);
+        hw.present[1]=0;now+=100ms;p.update();assert(p.status()==MotionStatus::Running);
+        hw.present[1]=90;now+=20ms;assert(p.update()==MotionStatus::Settling);
+    }
+    // Composed-cycle clock resets and speed scaling must survive a delayed gate.
+    {
+        auto now=RobotMotionPlayer::Clock::time_point{}+1s;
+        Hardware hw;RobotMotionPlayer p(path.string(),hw,[&]{return now;});
+        assert(p.initialize());assert(p.start("cycle")==StartResult::Accepted);
+        now+=50ms;p.update();assert(hw.goal.at(1)==30);
+        now+=100ms;hw.present[1]=30;p.update();
+        now+=25ms;p.update();assert(std::abs(hw.goal.at(1)-45)<1e-9);
+    }
+    // Overrides changed during a wait are sent and checked against the new target.
+    {
+        auto now=RobotMotionPlayer::Clock::time_point{}+1s;
+        Hardware hw;RobotMotionPlayer p(path.string(),hw,[&]{return now;});
+        assert(p.initialize());assert(p.start("single")==StartResult::Accepted);
+        p.setJointOverride(1,20);now+=100ms;p.update();assert(hw.goal.at(1)==20);
+        p.setJointOverride(1,40);hw.present[1]=40;now+=20ms;
+        assert(p.update()==MotionStatus::Settling);assert(hw.goal.at(1)==40);
+    }
+    for (const bool read_failure : {false,true}) {
+        auto now=RobotMotionPlayer::Clock::time_point{}+1s;
+        Hardware hw;RobotMotionPlayer p(path.string(),hw,[&]{return now;});
+        assert(p.initialize());assert(p.start("single")==StartResult::Accepted);
+        assert(p.queueNext("single")==QueueResult::Queued);
+        hw.read_ok=!read_failure;now+=100ms;p.update();
+        now+=3001ms;assert(p.update()==MotionStatus::Failed);
+        assert(p.result()==(read_failure?MotionError::PresentPositionReadFailed:MotionError::PositionTimeout));
+        assert(!p.hasQueuedMotion() && p.completionSequence()==0);
+    }
+    std::filesystem::remove(path);
+    std::cout<<"Frame gates: gaps, delayed polls, arrival tolerance, queues, repeats, cycles, overrides, cancellation and timeouts passed\n";
+}
