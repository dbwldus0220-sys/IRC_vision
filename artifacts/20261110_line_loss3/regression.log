        boundaries.append((getattr(self, "pending_line_corner", None) or {}).get("minimum_rgb_stamp_ns"))
        minimum_stamp = max([0] + [s for s in boundaries if type(s) is int])
        stamp = MotionDecisionNode._detection_stamp_ns(info or {})
