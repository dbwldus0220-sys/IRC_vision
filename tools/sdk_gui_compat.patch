+        if (id < 0 || id >= kMotionMotorCount || !std::isfinite(angle)) {
+            fail(MotionError::PresentPositionReadFailed, "invalid actual start pose");
+            return false;
+        }
+    }
+    start_angles_ = present;
+    feedback_angles_ = std::move(present);
+    return true;
