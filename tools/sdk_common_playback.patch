+}
+
+void RobotMotionPlayer::configureJointPolicy(
+    const std::string& reference_json, bool head, bool shoulder) {
+    if (running()) throw std::logic_error("cannot change policy during a motion");
+    if (!head || !shoulder) {
+        if (reference_json.empty())
+            throw std::invalid_argument("override OFF requires the PC reference catalog");
+        reference_library_ = std::make_unique<MotionLibrary>(
+            MotionLibrary::loadGuiJson(reference_json));
+    }
+    enable_head_override_ = head;
+    enable_shoulder_override_ = shoulder;
+}
+
+void RobotMotionPlayer::validatePolicyReference(
+    const MotionPattern& pattern, const std::string& name) const {
+    if (enable_head_override_ && enable_shoulder_override_) return;
+    if (!reference_library_ || !reference_library_->contains(name))
+        throw std::invalid_argument("PC reference missing motion for override OFF: " + name);
+    const auto& originals = reference_library_->motion(name).frames();
+    for (const auto& frame : pattern.frames()) {
+        const MotionFrame* match = nullptr;
+        for (const auto& original : originals) {
+            if ((!frame.frame_id.empty() && frame.frame_id == original.frame_id)
+                || (frame.name == original.name && frame.start_ms == original.start_ms)) {
+                if (match && match->angles != original.angles)
+                    throw std::invalid_argument("ambiguous PC reference frame: " + frame.name);
+                match = &original;
+            }
+        }
+        if (!match) throw std::invalid_argument("PC reference missing frame: " + frame.name);
+        for (int id : {0, 4, 5}) {
+            if ((id == 0 ? !enable_head_override_ : !enable_shoulder_override_)
+                && frame.angles.contains(id) && !match->angles.contains(id))
+                throw std::invalid_argument("PC reference missing policy joint");
+        }
+    }
+}
+
+const MotionFrame& RobotMotionPlayer::referenceFrame(const MotionFrame& frame) const {
+    for (const auto& original : reference_library_->motion(current_motion_).frames()) {
+        if ((!frame.frame_id.empty() && frame.frame_id == original.frame_id)
+            || (frame.name == original.name && frame.start_ms == original.start_ms))
+            return original;
+    }
+    throw std::logic_error("validated PC reference frame disappeared");
+}
+
+void RobotMotionPlayer::configureDiagnostics(
+    double expected_tick_ms, const std::string& path, bool goals, std::size_t capacity) {
+    if (running() || expected_tick_ms <= 0 || !std::isfinite(expected_tick_ms)
+        || capacity > 100000) throw std::invalid_argument("invalid diagnostics options");
+    expected_tick_ms_ = expected_tick_ms;
+    trace_goals_ = goals;
+    trace_capacity_ = path.empty() && !goals ? 0 : capacity;
+    trace_writer_.reset();
+    if (!path.empty()) trace_writer_ = std::make_unique<PlaybackTraceWriter>(path);
+}
+
+void RobotMotionPlayer::finishDiagnostics(
+    const std::shared_ptr<PlaybackDiagnostics>& d) {
+    if (!d || d->finished) return;
+    d->finished = true;
+    d->finished_ms = std::chrono::duration<double, std::milli>(now_().time_since_epoch()).count();
+    last_diagnostics_ = d;
+    std::cout << "[Playback summary] motion=" << d->motion << " ticks=" << d->ticks
+              << " mean_interval_ms=" << (d->interval_count ? d->interval_sum_ms / d->interval_count : 0)
+              << " max_interval_ms=" << d->max_interval_ms
+              << " over_7.5/10/20=" << d->over_7_5 << '/' << d->over_10 << '/' << d->over_20
+              << " final_corrections=" << d->final_corrections
+              << " goal_failures=" << d->goal_failures
+              << " queue_delay_ms=" << d->queue_delay_ms
+              << " elapsed_ms=" << d->finished_ms - d->started_ms
+              << " trace_dropped=" << d->dropped_trace << '\n';
+    if (trace_writer_ && !trace_writer_->enqueue(d))
+        std::cerr << "[Playback diagnostics] trace batch dropped: logger busy\n";
+}
 
